# SanMai AI — example environment configuration.
# All keys are read with the SANMAI_ prefix (see be/config.py).
# Copy to .env and fill in values. NEVER commit a real .env.
# Config is fail-loud: a missing/typo'd REQUIRED key raises at boot.

# --- compatibility contract (REQUIRED) ---
SANMAI_CONFIG_SCHEMA_VERSION=

# --- infrastructure (REQUIRED) ---
SANMAI_DATABASE_URL=
SANMAI_ENV=

# --- adapter selection (which provider each port binds to) ---
# payments/llm/fiscal are REQUIRED; the rest have safe fake defaults.
SANMAI_PAYMENTS_PROVIDER=
SANMAI_LLM_PROVIDER=
SANMAI_FISCAL_PROFILE=
SANMAI_NOTIFY_PROVIDER=
SANMAI_STORAGE_PROVIDER=
SANMAI_IDENTITY_PROVIDER=
